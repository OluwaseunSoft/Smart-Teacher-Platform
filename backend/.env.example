# ---- AI providers -----------------------------------------------------------
# generation provider: openai | anthropic | ollama
LLM_PROVIDER=ollama
# embedding provider: openai | ollama
EMBEDDING_PROVIDER=ollama

# model names (leave blank to use provider defaults)
LLM_MODEL=
EMBEDDING_MODEL=

# credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# local inference
OLLAMA_BASE_URL=http://localhost:11434

# ---- App --------------------------------------------------------------------
DATABASE_URL=sqlite:///./suhail.db
CORS_ORIGINS=http://localhost:5173
RETRIEVAL_TOP_K=5
MAX_UPLOAD_MB=20
# Docker only: seed demo data into an empty database volume on first start
SEED_DEMO_DATA=true

# ---- Auth -------------------------------------------------------------------
# CHANGE THIS in any non-local environment (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET_KEY=dev-insecure-change-me
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30
# Return password-reset tokens in the API response (dev only; requires a real mailer in prod)
AUTH_EXPOSE_RESET_TOKEN=true
# Optional bootstrap administrator, created on startup when both are set
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
